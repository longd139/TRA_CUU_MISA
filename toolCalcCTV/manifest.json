{
  "manifest_version": 3,
  "name": "Tra Cứu & Sửa Nhanh Giá CTV POS",
  "version": "1.1.0",
  "description": "Tự động hiển thị giá CTV và đồng bộ tồn kho tức thì theo thời gian thực từ MShopKeeper MISA.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Quản lý Giá CTV & File Excel"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.mshopkeeper.vn/*"
      ],
      "js": [
        "content/interceptor.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/interceptor.js"
      ],
      "matches": [
        "*://*.mshopkeeper.vn/*"
      ]
    }
  ]
}
